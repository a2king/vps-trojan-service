# 复制到 /etc/trojan-admin/ha.env（权限 600）后按需修改。
# 主控上用于 backup + sync；备控上 promote 会读 INSTALL_DIR / HA_INCOMING。
# 主备都建议启用 DNS 监听：你在域名面板改 A 记录后，机器每 5 分钟自检并切换角色。

# 安装目录（含 backend/、.env）
INSTALL_DIR=/opt/vps-trojan-service

# 主控本地备份目录（sqlite online backup 输出）
HA_BACKUP_DIR=/var/lib/trojan-admin/ha-backup

# 备控接收目录（rsync 目标；promote 从此目录套用）
HA_INCOMING=/var/lib/trojan-admin/ha-incoming

# 备控 SSH（仅主控 sync 需要）
STANDBY_HOST=
STANDBY_PORT=22
STANDBY_USER=root
# 为空则使用主控 data/ssh 私钥；也可填绝对路径
STANDBY_SSH_KEY=

# rsync/ssh 额外参数（可选）
# RSYNC_RSH_EXTRA=-o StrictHostKeyChecking=accept-new

# —— DNS 自动切换（control-dns-watch）——
# 监听的管控域名；留空则读安装目录 .env 的 DOMAIN
CONTROL_DNS_NAME=
# 本机公网 IPv4（强烈建议填死，避免探测失败）；留空则访问 ipify/ifconfig 探测
CONTROL_LOCAL_IP=
# 用于解析的公共 DNS（避免本机缓存过期记录）
DNS_RESOLVERS=1.1.1.1 8.8.8.8
