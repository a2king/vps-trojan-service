# 管理后台
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRE_HOURS=168

# 对外域名（用于拼接 trojan:// 分享链接）
DOMAIN=example.com
TROJAN_PORT=443

# SQLite（唯一数据库，无需 MariaDB）
DATABASE_URL=sqlite:///./data/trojan.db

# Trojan 连接本进程内的 MySQL 兼容端口，读写 SQLite 用户表
TROJAN_MYSQL_HOST=127.0.0.1
TROJAN_MYSQL_PORT=13306

# 流量采集间隔（秒）；日流量与日志最多保留天数
TRAFFIC_INTERVAL_SECONDS=300
LOG_RETENTION_DAYS=31
TIMEZONE=Asia/Shanghai
TROJAN_LOG_PATH=/var/log/trojan.log
