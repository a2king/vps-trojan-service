# 管理后台
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRE_HOURS=24

# 对外域名（用于拼接 trojan:// 分享链接）
DOMAIN=example.com
TROJAN_PORT=443

# SQLite（唯一数据库，无需 MariaDB）
DATABASE_URL=sqlite:///./data/trojan.db

# 主控角色：primary=源库并向备机同步；standby=页面安装的完整备机
CONTROL_ROLE=primary
# 向各备机推送数据库快照的间隔（秒，默认 6 小时）
REPLICA_SYNC_INTERVAL_SECONDS=21600

# Trojan 连接本进程内的 MySQL 兼容端口，读写 SQLite 用户表
TROJAN_MYSQL_HOST=127.0.0.1
TROJAN_MYSQL_PORT=13306

# 流量采集间隔（秒，只读主控库）；登录 IP 采集间隔（秒，会 SSH 子节点）
TRAFFIC_INTERVAL_SECONDS=300
IP_INGEST_INTERVAL_SECONDS=3600
LOG_RETENTION_DAYS=31
TIMEZONE=Asia/Shanghai
TROJAN_LOG_PATH=/var/log/trojan.log
